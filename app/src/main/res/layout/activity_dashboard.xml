<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/brand_background"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ParchApp"
            android:textColor="@color/brand_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/header_search_btn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_light_blue"
            android:contentDescription="@string/cd_search"
            android:padding="9dp"
            android:src="@drawable/ic_search"
            android:tint="@color/brand_dark" />

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp">
            <ImageButton
                android:id="@+id/header_notif_btn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_light_blue"
                android:contentDescription="@string/cd_notifications"
                android:padding="9dp"
                android:src="@drawable/ic_notifications"
                android:tint="@color/brand_dark" />
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_oval_solid"
                android:backgroundTint="@color/brand_rose" />
        </FrameLayout>

        <TextView
            android:id="@+id/header_user_initials"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_primary_pill"
            android:gravity="center"
            android:text="AK"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- F3: shown while the phone has no connection -->
    <TextView
        android:id="@+id/offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FEF3C7"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/offline_banner"
        android:textColor="#92400E"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp">

            <!-- Greeting -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/greeting_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hello, Alex! 👋" android:textColor="@color/brand_dark" android:textSize="24sp" android:textStyle="bold" />
                    <TextView android:id="@+id/active_plans_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="You have 2 active plans today" android:textColor="@color/brand_slate" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:id="@+id/status_header_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_green_chip" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="● FREE" android:textColor="@color/brand_success_dark" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Invite friends card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_dashboard_card" android:elevation="2dp" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_icon_badge" android:gravity="center" android:text="⇄" android:textColor="@color/brand_primary" android:textSize="16sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/invite_friends_title" android:textColor="@color/brand_dark" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/invite_friends_subtitle" android:textColor="@color/brand_slate" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="12dp" android:background="@drawable/bg_login_field" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="6dp">
                    <TextView android:id="@+id/invite_link_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:text="parchapp.me/u/alex-k26" android:textColor="@color/brand_slate" android:textSize="11sp" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/copy_link_button" android:layout_width="wrap_content" android:layout_height="34dp" android:background="@drawable/bg_primary_pill" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/copy_link" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick status card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_dashboard_blue" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡  QUICK STATUS" android:textColor="#BFD5FF" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:id="@+id/status_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/available_now" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/status_source_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_green_chip" android:paddingStart="8dp" android:paddingTop="6dp" android:paddingEnd="8dp" android:paddingBottom="6dp" android:text="● Live Sync" android:textColor="@color/brand_success_dark" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/btn_edit_free_until" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="#2B64C6" android:orientation="vertical" android:padding="10dp">
                        <TextView android:id="@+id/free_until_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/free_until_label" android:textColor="#BFD5FF" android:textSize="9sp" />
                        <TextView android:id="@+id/display_free_until" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4:00 PM" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/btn_edit_next_activity" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:background="#2B64C6" android:orientation="vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/next_activity_label" android:textColor="#BFD5FF" android:textSize="9sp" />
                        <TextView android:id="@+id/display_next_activity" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:text="Library Study" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/compare_button" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="12dp" android:background="@drawable/bg_google_button" android:text="⚡  Compare Availability with Group  →" android:textAllCaps="false" android:textColor="@color/brand_primary" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Today's plans -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/todays_plans" android:textColor="@color/brand_dark" android:textSize="16sp" android:textStyle="bold" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/calendar_button" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_light_blue" android:text="View calendar  ›" android:textAllCaps="false" android:textColor="@color/brand_primary" android:textSize="11sp" />
            </LinearLayout>

            <!-- Plan card 1: Confirmed study session -->
            <LinearLayout android:id="@+id/plan_card_study" android:clickable="true" android:focusable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="14dp">
                <TextView android:id="@+id/plan_status_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_green_chip" android:paddingStart="8dp" android:paddingTop="5dp" android:paddingEnd="8dp" android:paddingBottom="5dp" android:textColor="@color/brand_success_dark" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/plan_title_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/brand_dark" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/plan_time_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/brand_slate" android:textSize="11sp" />
                <TextView android:id="@+id/plan_location_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/brand_slate" android:textSize="11sp" />
                <!-- F3 and F7: travel time to the venue and a warning when the plan starts before you can arrive -->
                <TextView android:id="@+id/plan_travel_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/brand_primary" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
                <TextView android:id="@+id/plan_late_warning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_late_warning" android:padding="8dp" android:text="@string/late_warning" android:textColor="#B91C1C" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
                <View android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="12dp" android:background="@drawable/bg_progress_track" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal">
                        <TextView android:id="@+id/plan_avatar_1" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_oval_solid" android:backgroundTint="#60A5FA" android:gravity="center" android:text="MK" android:textColor="@android:color/white" android:textSize="9sp" android:textStyle="bold" />
                        <TextView android:id="@+id/plan_avatar_2" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="-8dp" android:background="@drawable/bg_oval_solid" android:backgroundTint="@color/brand_indigo" android:gravity="center" android:text="SR" android:textColor="@android:color/white" android:textSize="9sp" android:textStyle="bold" />
                        <TextView android:id="@+id/plan_avatar_3" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="-8dp" android:background="@drawable/bg_oval_solid" android:backgroundTint="@color/brand_success" android:gravity="center" android:text="JD" android:textColor="@android:color/white" android:textSize="9sp" android:textStyle="bold" />
                        <TextView android:id="@+id/plan_avatar_more" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="-8dp" android:background="@drawable/bg_oval_solid" android:backgroundTint="@color/brand_primary" android:gravity="center" android:text="+1" android:textColor="@android:color/white" android:textSize="9sp" android:textStyle="bold" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/plan_details_button" android:layout_width="wrap_content" android:layout_height="34dp" android:background="@drawable/bg_light_blue" android:minWidth="0dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="@string/details" android:textAllCaps="false" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Plan card 2: Soccer voting -->
            <LinearLayout android:id="@+id/plan_card_rsvp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="@color/brand_primary" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/soccer_vote_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_light_blue" android:paddingStart="8dp" android:paddingTop="5dp" android:paddingEnd="8dp" android:paddingBottom="5dp" android:text="◷  Voting pending • 3/6" android:textColor="@color/brand_primary" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/rsvp_plan_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/brand_dark" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/rsvp_plan_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/brand_slate" android:textSize="11sp" />
                    <TextView android:id="@+id/rsvp_plan_location" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/brand_slate" android:textSize="11sp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="10dp" android:background="@drawable/bg_progress_track">
                        <View android:id="@+id/soccer_progress_bar" android:layout_width="50dp" android:layout_height="match_parent" android:background="@drawable/bg_progress_fill" android:backgroundTint="@color/brand_primary" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/joining_question" android:textColor="@color/brand_slate" android:textSize="11sp" android:textStyle="bold" />
                        <androidx.appcompat.widget.AppCompatButton android:id="@+id/going_button" android:layout_width="wrap_content" android:layout_height="34dp" android:background="@drawable/bg_green_chip" android:minWidth="0dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="✓ Going" android:textAllCaps="false" android:textColor="@color/brand_success_dark" android:textSize="11sp" android:textStyle="bold" />
                        <androidx.appcompat.widget.AppCompatButton android:id="@+id/maybe_button" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="6dp" android:background="@drawable/bg_light_blue" android:minWidth="0dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="@string/maybe" android:textAllCaps="false" android:textColor="@color/brand_slate" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Active groups -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/your_active_groups" android:textColor="@color/brand_dark" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/view_all_groups_button" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:text="@string/view_all_groups" android:textColor="@color/brand_primary" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/group_card_eng" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="12dp">
                    <TextView android:id="@+id/group_card_eng_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" />
                    <TextView android:id="@+id/group_card_eng_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/group_card_eng_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/brand_slate" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Open chat  →" android:textColor="@color/brand_primary" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/roomies_group_card" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="12dp">
                    <TextView android:id="@+id/group_card_roomies_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/brand_purple" android:textSize="20sp" />
                    <TextView android:id="@+id/group_card_roomies_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/group_card_roomies_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/brand_slate" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="View status  →" android:textColor="@color/brand_dark" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton android:id="@+id/new_activity_button" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_gravity="end" android:layout_marginEnd="14dp" android:layout_marginBottom="-22dp" android:background="@drawable/bg_primary_pill" android:elevation="6dp" android:text="＋  New Activity" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="11sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@android:color/white" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/nav_home" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="⌂\nHome" android:textColor="@color/brand_primary" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/nav_groups" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="♧\nGroups" android:textColor="@color/brand_slate" android:textSize="11sp" />
        <TextView android:id="@+id/nav_schedule" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="▣\nSchedule" android:textColor="@color/brand_slate" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
